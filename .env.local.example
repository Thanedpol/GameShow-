# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์จริง
# (ห้าม commit .env.local เข้า git)

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ไม่บังคับ — เปลี่ยนโมเดลที่ใช้สร้างคำใบ้ (ค่าเริ่มต้น: claude-opus-5)
# ถ้าอยากได้คำใบ้เร็วขึ้นในการเดโม ลองใช้ claude-haiku-4-5
# HINT_MODEL=claude-opus-5

# ไม่บังคับ — คีย์ที่ใช้เข้ารหัส label "จริง/หลอก" ลงใน revealToken
# ถ้าไม่ตั้ง ระบบจะ derive จาก ANTHROPIC_API_KEY ให้เอง (คงที่ทุก instance อยู่แล้ว)
# ตั้งเองเมื่อต้องการหมุนคีย์โดยไม่แตะ ANTHROPIC_API_KEY — สร้างด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REVEAL_SECRET=
